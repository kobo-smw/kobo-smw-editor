#!/bin/bash
# The ROM a hack's hook sites go back to before Kobo's code goes over them, for the
# with-kobo scripts:
#   base-rom hack.smc
# prints the vanilla ROM's path (KOBO_SMW_ROM or `roms.smw`), or for an SA-1
# hack ($00FFD5 = $23) the SA-1 reference ROM, the vanilla ROM with SA-1 Pack applied
# (docs/sa1.md): KOBO_SA1_REFERENCE or `tests.sa1_reference` (tools/kobo_config.py).
set -euo pipefail
here=$(dirname "$(realpath "$0")")
sa1=$(python3 - "$1" <<'PY'
import sys
d = open(sys.argv[1], 'rb').read()
d = d[len(d) % 0x8000:]
print(1 if d[0x7FD5] == 0x23 else 0)
PY
)
if [ "$sa1" = 1 ]; then
  python3 "$here/../kobo_config.py" sa1_reference
else
  python3 "$here/../kobo_config.py" rom
fi
