#!/bin/bash
# A Lunar Magic-saved ROM with layer 3 settings, with Kobo's layer 3 code
# (asm/lunar-magic/layer3.asm) in place of Lunar Magic's: its four hook sites put back to
# the game's bytes, then layer3.asm applied, keeping the ROM's lists:
#   with-kobo-layer3 lm.smc out.sfc
# then compare the two with examples/layer3_probe.rs (loads, compare) and
# examples/render_hashes. Lunar Magic's header hook leaves where the level's list is
# at $7FC006, as graphics.asm's does, so either graphics loader serves.
# Needs `kobo` (KOBO, default on PATH), Asar's library (KOBO_ASAR_LIB), and the vanilla
# ROM (KOBO_SMW_ROM or kobo's configuration), or for an SA-1
# ROM the vanilla ROM with SA-1 Pack (KOBO_SA1_BASE, base-rom).
set -euo pipefail
here=$(dirname "$(realpath "$0")")
K=${KOBO:-kobo}; A=$here/../../crates/kobo-core/asm/lunar-magic
# The game's bytes: the vanilla ROM's, or SA-1 Pack's for an SA-1 ROM (base-rom).
vanilla=$("$here/base-rom" "$1")
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
python3 - "$1" "$vanilla" "$t/0.sfc" <<'PY'
import sys
def load(p):
    d = open(p, 'rb').read(); return bytearray(d[len(d) % 0x8000:])
def pc(a): return ((a >> 16) & 0x7F) * 0x8000 + (a & 0x7FFF)
d, v = load(sys.argv[1]), load(sys.argv[2])
# The layer 3 settings' hooks (docs/lunar-magic-install.md, "Layer 3 settings"): the
# setup, the overworld's, the sprite edge tile, and the frame's scroll.
for a, b in [(0x00A01F, 0x00A024), (0x00A153, 0x00A156), (0x0194B6, 0x0194BA),
             (0x05C40C, 0x05C410)]:
    d[pc(a):pc(b) + 1] = v[pc(a):pc(b) + 1]
open(sys.argv[3], 'wb').write(d)
PY
"$K" asm "$A/layer3.asm" "$2" -r "$t/0.sfc" >/dev/null
