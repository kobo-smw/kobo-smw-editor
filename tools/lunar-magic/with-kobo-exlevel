#!/bin/bash
# A Lunar Magic-saved ROM with Kobo's taller levels piece (asm/lunar-magic/exlevel.asm)
# in place of Lunar Magic's, keeping the ROM's level size table, so a hack's content
# runs through both implementations:
#   with-kobo-exlevel lm.smc out.sfc
# then compare the two with examples/exlevel_probe.rs compare, render_hashes, and
# ramdiff.py. Every site of Lunar Magic's piece (the bytes a save leaves alone when
# $05DA8A is a JSL and rewrites when it is not, docs/lunar-magic-install.md) is put
# back to the clean ROM's first, but for GenerateTile's VRAM address and its view
# checks ($00BF35-$00BF9A, $00C116, $00C122), which belong to the VRAM patch in Kobo's
# layout: Lunar Magic's stay. The size table moves to where Kobo's code has it, $240
# bytes before the code $05DA8A calls. Nothing of Lunar Magic's code is read or
# printed: bytes are copied between ROMs by address.
# Needs `kobo` (KOBO, default on PATH), Asar's library (KOBO_ASAR_LIB), and the
# vanilla ROM (KOBO_SMW_ROM or kobo's configuration), or for an SA-1 ROM the vanilla ROM
# with SA-1 Pack (KOBO_SA1_BASE, base-rom).
set -euo pipefail
here=$(dirname "$(realpath "$0")")
K=${KOBO:-kobo}; A=$here/../../crates/kobo-core/asm/lunar-magic
# The game's bytes: the vanilla ROM's, or SA-1 Pack's for an SA-1 ROM (base-rom).
vanilla=$("$here/base-rom" "$1")
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
python3 - "$1" "$vanilla" $t/0.sfc $t/table.bin <<'PY'
import sys
def ld(p):
  d=open(p,'rb').read(); return bytearray(d[len(d)%0x8000:])
def pc(a): return ((a>>16)&0x7f)*0x8000+(a&0x7fff)
# A pointer the ROM holds may name any bank: on SA-1 $80-$BF and $C0-$FF are
# other megabytes of ROM, not mirrors (Super MMC's reset, or 04-07 past 4 MiB).
def rom_pc(d,a):
  if d[0x7FD5]!=0x23: return pc(a)
  bank=a>>16
  if bank>=0xC0: return (((bank>>4)&3)+(4 if len(d)>0x400000 else 0))*0x100000+(a&0xFFFFF)
  return (((bank>>5)&1)|((bank>>6)&2))*0x100000+(bank&0x1F)*0x8000+(a&0x7FFF)
def r3(d,a): return d[pc(a)]|d[pc(a)+1]<<8|d[pc(a)+2]<<16
d=ld(sys.argv[1]); v=ld(sys.argv[2])
assert d[pc(0x05DA8A)]==0x22, 'no taller levels in this ROM'
table=rom_pc(d,r3(d,0x05DA8B)-0x240)
open(sys.argv[4],'wb').write(d[table:table+0x200])
sites='''00A1CF-00A1D2 00A2AF-00A2D4 00BDA8-00BEA7 00BEE8-00BEEE 00C07D 00C0CA 00C1B5 00C3D7
00F478-00F47A 00F493-00F494 00F49B-00F49C 00F4F3-00F4F5 00F50E-00F50F 00F516-00F517
00F70D-00F710 0194D6-0194D8 019501-019502 01950A-01950B 019513-019514 01951C-01951D
01D97C-01D97D 01D982-01D983 0292D7-0292DA 0292FA-0292FB 029302-029303 02930B-02930C
029313-029314 02950B-02950F 0295BE-0295C1 0295ED-0295EE 0295F5-0295F6 0295FE-0295FF
029606-029607 02A6BB-02A6BC 02A6C3-02A6C4 02A6CC-02A6CD 02A6D4-02A6D5 02BA4E-02BA51
02BA72-02BA73 02BA7A-02BA7B 02BA83-02BA84 02BA8B-02BA8C 02D158-02D15B 02D18D-02D18E
02D195-02D196 02D19E-02D19F 02D1A6-02D1A7 03D793-03D795 058A1A 058AF6 058BE8 058CDB
05D8FC 05D9A1-05D9A4 05DA8A-05DA8D 05DB5F-05DB62 0C9436-0C9439 0DA963-0DA973
0DA9D6-0DAA04'''.split()
for s in sites:
  a,_,b=s.partition('-'); a=pc(int(a,16)); b=pc(int(b or s,16))+1
  d[a:b]=v[a:b]
open(sys.argv[3],'wb').write(d)
PY
$K asm $A/exlevel.asm $t/1.sfc -r $t/0.sfc >/dev/null
python3 - $t/1.sfc $t/table.bin $t/2.sfc <<'PY'
import sys
d=bytearray(open(sys.argv[1],'rb').read())
def pc(a): return ((a>>16)&0x7f)*0x8000+(a&0x7fff)
def rom_pc(d,a):
  if d[0x7FD5]!=0x23: return pc(a)
  bank=a>>16
  if bank>=0xC0: return (((bank>>4)&3)+(4 if len(d)>0x400000 else 0))*0x100000+(a&0xFFFFF)
  return (((bank>>5)&1)|((bank>>6)&2))*0x100000+(bank&0x1F)*0x8000+(a&0x7FFF)
def r3(d,a): return d[pc(a)]|d[pc(a)+1]<<8|d[pc(a)+2]<<16
table=rom_pc(d,r3(d,0x05DA8B)-0x240)
d[table:table+0x200]=open(sys.argv[2],'rb').read()
open(sys.argv[3],'wb').write(d)
PY
# Kobo fixes the checksum, mirroring a size that is not a power of two.
echo lorom > $t/empty.asm
$K asm $t/empty.asm "$2" -r $t/2.sfc >/dev/null
