#!/usr/bin/env python3
"""Imports and builds every hack of the corpus, and lists what blocks each.

    corpus-sweep out/ [hack.smc|patch.bps ...] [--no-render] [--no-save] [--only text]
                      [--baseline old/results.json] [--no-build]

Takes the hacks named, else the corpus (KOBO_LM_ROMS or `tests.lm_roms`,
tools/kobo_config.py). For each it imports the hack's changed levels into a
project and builds it; a build refused for a level drops that level from the
project and builds again, until the rest builds or a refusal names no level.
The build that results is compared with the hack (`kobo diff`, and
`render_hashes` over the levels it holds) and saved by Lunar Magic
(`tools/lunar-magic/save-check`). Writes `out/<hack>/` (the project, the
build, each step's output), `out/results.json` (each hack by its headerless
SHA-1, with the revision swept), and `out/summary.md`.

It builds `kobo` and the `render_hashes` example in release first
(`--no-build` leaves them; KOBO_BIN names another `kobo`), and reads what
they report as JSON. A sweep that stopped part way resumes from
results.json, for hacks swept at the same revision. With `--baseline`, each
hack is compared with its result in an earlier sweep, and what got worse
(a stage not reached, more levels refused, a diff or a save that passed
and fails, fewer pictures the same) is listed in summary.md and fails the
sweep.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
KOBO = Path(os.environ.get("KOBO_BIN", ROOT / "target/release/kobo"))
RENDER = ROOT / "target/release/examples/render_hashes"
SAVE_CHECK = ROOT / "tools/lunar-magic/save-check"
sys.path.insert(0, str(ROOT / "tools"))
import kobo_config  # noqa: E402


def run_split(args, cwd=None, log=None, timeout=1800):
    """(exit code, standard output, standard error)."""
    env = dict(os.environ, PATH=f"{KOBO.parent}{os.pathsep}{os.environ['PATH']}")
    try:
        p = subprocess.run(
            [str(a) for a in args],
            cwd=cwd,
            env=env,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=timeout,
        )
        out, err, code = p.stdout, p.stderr, p.returncode
    except subprocess.TimeoutExpired:
        out, err, code = "", f"timed out after {timeout}s\n", -1
    if log:
        with open(log, "a") as f:
            f.write(f"$ {' '.join(str(a) for a in args)}\n{out}{err}(exit {code})\n\n")
    return code, out, err


def run(args, cwd=None, log=None, timeout=1800):
    code, out, err = run_split(args, cwd, log, timeout)
    return code, out + err


def run_json(args, log=None, timeout=1800):
    """(exit code, the JSON a `--json` command printed, or None, its error output)."""
    code, out, err = run_split([*args, "--json"], log=log, timeout=timeout)
    try:
        return code, json.loads(out), err
    except json.JSONDecodeError:
        return code, None, err or out


def revision():
    """The commit swept, `+` if the tree had changes."""
    head = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short=12", "HEAD"],
                          capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", ROOT, "status", "--porcelain", "--untracked-files=no"],
                           capture_output=True, text=True).stdout.strip()
    return head + ("+" if dirty else "")


def build_binaries():
    for what in (["--package", "kobo-cli"], ["--package", "kobo-core", "--example", "render_hashes"]):
        print(f"cargo build --release {' '.join(what)}", flush=True)
        subprocess.run(["cargo", "build", "--release", "--quiet", *what], cwd=ROOT, check=True)


def kind(message):
    """A message with its numbers taken out, to group alike ones."""
    message = re.sub(r"\bExGFX[0-9A-F]+\b", "ExGFX#", message)
    message = re.sub(r"\bbyte [0-9A-F]{2}\b", "byte #", message)
    message = re.sub(r"\b[0-9A-Fa-f]*[0-9][0-9A-Fa-f]*\b", "#", message)
    message = re.sub(r"(?<=[A-Za-z])[0-9]+\b", "#", message)
    message = re.sub(r"\((?:[0-9A-F]{2}|#)\)", "(#)", message)
    return re.sub(r"\$#", "#", message)


def error_of(output):
    """The `Error:` line of a failed command, with its causes."""
    lines = output.splitlines()
    for i, line in enumerate(lines):
        if line.startswith("Error: "):
            causes = [l.strip() for l in lines[i + 1 :] if l.strip() and l.strip() != "Caused by:"]
            return line[len("Error: ") :], causes
    tail = [l for l in lines if l.strip()]
    return (tail[-1] if tail else "no output"), []


def manifest_levels(project):
    text = (project / "kobo.toml").read_text()
    section = text.split("\n[levels]\n", 1)
    if len(section) < 2:
        return []
    return re.findall(r"^0x([0-9A-Fa-f]+) = ", section[1].split("\n[", 1)[0], re.M)


def drop_level(project, level):
    path = project / "kobo.toml"
    head, sep, rest = path.read_text().partition("\n[levels]\n")
    body, more, tail = rest.partition("\n[")
    body, n = re.subn(rf"^0x0*{int(level, 16):X} = .*\n?", "", body, flags=re.M | re.I)
    if n == 0:
        body, n = re.subn(rf"^0x0*{int(level, 16):03X} = .*\n?", "", body, flags=re.M | re.I)
    path.write_text(head + sep + body + more + tail)
    return n > 0


def import_report(value):
    """The import's `--json` report, its notes grouped by kind."""
    report = {"notes": defaultdict(int), "note_levels": defaultdict(set)}
    for note in value.get("notes", []):
        m = re.match(r"level ([0-9A-F]{3}): (.*)", note)
        k = kind(m.group(2) if m else note)
        report["notes"][k] += 1
        if m:
            report["note_levels"][k].add(m.group(1))
    not_imported = value.get("not_imported", {})
    report["ranges"], report["range_bytes"] = not_imported.get("ranges", 0), not_imported.get("range_bytes", 0)
    report["blocks"], report["block_bytes"] = not_imported.get("blocks", 0), not_imported.get("block_bytes", 0)
    report["levels"], report["pages"] = len(value.get("levels", [])), len(value.get("map16_pages", []))
    report["notes"] = dict(report["notes"])
    report["note_levels"] = {k: len(v) for k, v in report["note_levels"].items()}
    return report


def render_compare(hack, built, levels, log):
    """The pictures of the levels built, in the hack and in the build: the
    two picture hashes compared, the diagnostics column apart."""
    if not levels:
        return {"levels": 0, "same": 0, "differ": [], "errors": [], "diagnostics_differ": []}
    hashes = []
    for rom in (hack, built):
        code, out, err = run_split([RENDER, rom, *levels], timeout=7200)
        with open(log, "a") as f:
            f.write(f"$ render_hashes {rom}\n{out}{err}(exit {code})\n\n")
        hashes.append({l.split()[0]: l.split(" ")[1:] for l in out.splitlines() if l.strip()})
    a, b = hashes
    same, differ, errors, diagnostics = 0, [], [], []
    for level in sorted(a):
        x, y = a[level], b.get(level, ["error:"])
        if x[0].startswith("error") or y[0].startswith("error"):
            errors.append(level)
        elif x[:2] == y[:2]:
            same += 1
            if x[2:] != y[2:]:
                diagnostics.append(level)
        else:
            differ.append(level)
    return {"levels": len(a), "same": same, "differ": differ, "errors": errors,
            "diagnostics_differ": diagnostics}


def sweep(hack, out, render, save):
    name = hack.stem if hack.parent.name not in ("QLDC 2021", "QLDC 2022") else f"{hack.parent.name}/{hack.stem}"
    work = out / re.sub(r"[^A-Za-z0-9._-]+", "_", name)
    subprocess.run(["rm", "-rf", str(work)])
    work.mkdir(parents=True)
    log = work / "log.txt"
    result = {"hack": name, "path": str(hack), "revision": REVISION}
    started = time.time()

    rom = hack
    if hack.suffix.lower() == ".bps":
        rom = work / "hack.sfc"
        code, output = run([KOBO, "bps", "apply", hack, rom], log=log)
        if code:
            result["stage"] = "patch"
            result["error"] = error_of(output)[0]
            return result
    code, info, err = run_json([KOBO, "rom", "info", "-r", rom], log=log)
    if info is None:
        result["stage"] = "rom"
        result["error"] = error_of(err)[0]
        return result
    result["sha1"] = info["sha1"]
    result["mapping"] = info["mapping"]
    result["lunar_magic"] = info["lunar_magic"]

    project = work / "project"
    code, value, err = run_json([KOBO, "import", rom, project], log=log)
    if code or value is None or not value.get("ok"):
        result["stage"] = "import"
        value = value or {}
        result["error"] = value.get("error") or error_of(err)[0]
        result["causes"] = value.get("causes", [])
        return result
    result["import"] = import_report(value)
    result["imported_levels"] = len(manifest_levels(project))

    built = work / "build.sfc"
    refusals = []
    while True:
        code, value, err = run_json([KOBO, "build", project, "-o", built], log=log)
        if code == 0 and value and value.get("ok"):
            break
        value = value or {"error": error_of(err)[0]}
        level, message = value.get("level"), value.get("message")
        if not level or not drop_level(project, level):
            result["stage"] = "build"
            result["error"], result["causes"] = value.get("error"), value.get("causes", [])
            result["refusals"] = refusals
            return result
        refusals.append({"level": level, "message": message, "kind": kind(message)})
    result["refusals"] = refusals
    levels = manifest_levels(project)
    result["built_levels"] = len(levels)

    code, value, err = run_json([KOBO, "diff", rom, built, "--project", project], log=log)
    differ = (value or {}).get("levels", [])
    lines = [f"{d['level']}: {', '.join(d['parts'])}" for d in differ] or ([] if value else [err.strip()])
    result["diff"] = {"same": code == 0 and bool(value) and value["same"], "lines": lines[:40]}

    if render:
        result["render"] = render_compare(rom, built, levels, log)
    if save:
        # save-check ends with `kobo diff`: its exit is the comparison's.
        code, output = run([SAVE_CHECK, built, "105", project], log=log, timeout=900)
        lines = [l for l in output.splitlines() if l.strip()]
        result["save"] = {"same": code == 0, "lines": lines[-20:]}
    result["stage"] = "done"
    result["seconds"] = round(time.time() - started)
    return result


def regressions(results, baseline):
    """What got worse against the baseline's result for the same hack (by
    SHA-1, else by path), as (hack, what) pairs."""
    old = {}
    for r in baseline:
        old[r.get("sha1") or r["path"]] = r
    stages = ["patch", "rom", "import", "build", "done"]
    out = []
    for r in results:
        b = old.get(r.get("sha1") or r["path"]) or old.get(r["path"])
        if b is None:
            continue
        def rank(x):
            return stages.index(x.get("stage")) if x.get("stage") in stages else -1
        if rank(r) < rank(b):
            out.append((r["hack"], f"stopped at {r.get('stage')}, was {b.get('stage')}: {r.get('error')}"))
            continue
        if len(r.get("refusals", [])) > len(b.get("refusals", [])):
            new = {x["level"] for x in r["refusals"]} - {x["level"] for x in b.get("refusals", [])}
            out.append((r["hack"], f"{len(r['refusals'])} levels refused, was {len(b.get('refusals', []))}"
                        + (f" (new: {' '.join(sorted(new))})" if new else "")))
        for part in ("diff", "save"):
            if b.get(part, {}).get("same") and part in r and not r[part]["same"]:
                out.append((r["hack"], f"{part} passed and fails: {(r[part]['lines'] or ['?'])[0]}"))
        rb, rr = b.get("render"), r.get("render")
        if rb and rr:
            worse = sorted(set(rr["differ"] + rr["errors"]) - set(rb["differ"] + rb["errors"]))
            if worse:
                out.append((r["hack"], f"{len(worse)} pictures differ that did not: {' '.join(worse[:24])}"))
    return out


def summary(results, against=None):
    rows = [
        "| Hack | LM | Mapping | Stage | Levels | Built | Refused | Not imported | Diff | Render same | Save |",
        "|---|---|---|---|---|---|---|---|---|---|---|",
    ]
    kinds = defaultdict(lambda: [set(), 0])
    for r in results:
        imp = r.get("import", {})
        refused = r.get("refusals", [])
        for x in refused:
            kinds[kind(x["message"])][0].add(r["hack"])
            kinds[kind(x["message"])][1] += 1
        stop = r.get("error")
        if stop:
            kinds["stopped: " + kind(stop)][0].add(r["hack"])
            kinds["stopped: " + kind(stop)][1] += 1
        render = r.get("render")
        rows.append(
            "| {} | {} | {} | {} | {} | {} | {} | {} | {} | {} | {} |".format(
                r["hack"],
                r.get("lunar_magic") or "",
                r.get("mapping") or "",
                r.get("stage", ""),
                r.get("imported_levels", ""),
                r.get("built_levels", ""),
                len(refused),
                f"{imp.get('ranges', 0)} ranges / {imp.get('blocks', 0)} blocks" if imp else "",
                "" if "diff" not in r else ("same" if r["diff"]["same"] else (r["diff"]["lines"] or ["?"])[0]),
                "" if not render else f"{render['same']}/{render['levels']}",
                "" if "save" not in r else ("same" if r["save"]["same"] else "differs"),
            )
        )
    table = ["| Refusal or stop | Hacks | Levels |", "|---|---|---|"]
    for k, (hacks, n) in sorted(kinds.items(), key=lambda kv: (-len(kv[1][0]), -kv[1][1])):
        table.append(f"| {k.replace('|', '/')} | {len(hacks)} | {n} |")
    notes = defaultdict(lambda: [0, 0])
    for r in results:
        for k, n in r.get("import", {}).get("notes", {}).items():
            k = kind(k)
            notes[k][0] += 1
            notes[k][1] += n
    note_table = ["| Import note | Hacks | Times |", "|---|---|---|"]
    for k, (h, n) in sorted(notes.items(), key=lambda kv: (-kv[1][0], -kv[1][1])):
        note_table.append(f"| {k.replace('|', '/')} | {h} | {n} |")
    revisions = sorted({r.get("revision") or "?" for r in results})
    head = ["# Corpus sweep", "", f"Revision {', '.join(revisions)}.", ""]
    if against is not None:
        head += ["## Against the baseline", ""]
        head += [f"- {h}: {w}" for h, w in against] or ["Nothing got worse."]
        head += [""]
    return "\n".join(
        [*head, "## Per hack", "", *rows, "", "## Refusals", "", *table, "",
         "## Import notes", "", *note_table, ""]
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("out", type=Path)
    parser.add_argument("hacks", nargs="*", type=Path)
    parser.add_argument("--no-render", action="store_true")
    parser.add_argument("--no-save", action="store_true")
    parser.add_argument("--only", help="only hacks whose path contains this")
    parser.add_argument("--summary", action="store_true", help="only rewrite summary.md from results.json")
    parser.add_argument("--baseline", type=Path, help="an earlier sweep's results.json to compare with")
    parser.add_argument("--no-build", action="store_true", help="use kobo and render_hashes as built")
    args = parser.parse_args()
    args.out.mkdir(parents=True, exist_ok=True)
    results_path = args.out / "results.json"
    baseline = json.loads(args.baseline.read_text()) if args.baseline else None
    if args.summary:
        results = json.loads(results_path.read_text())
        against = regressions(results, baseline) if baseline is not None else None
        (args.out / "summary.md").write_text(summary(results, against))
        return 1 if against else 0
    hacks = args.hacks or kobo_config.paths("lm_roms") or []
    if not hacks:
        sys.exit("no hacks: name them, or set KOBO_LM_ROMS or `tests.lm_roms`")
    if args.only:
        hacks = [h for h in hacks if args.only in str(h)]
    if not args.no_build:
        build_binaries()
    # A sweep that stopped part way resumes: hacks already swept at this
    # revision keep their result.
    done = {}
    if results_path.exists():
        for r in json.loads(results_path.read_text()):
            if r.get("revision") == REVISION and not str(r.get("error", "")).startswith("failed to write"):
                done[r["path"]] = r
    results = []
    for i, hack in enumerate(hacks, 1):
        if str(hack) in done:
            results.append(done[str(hack)])
            continue
        print(f"[{i}/{len(hacks)}] {hack.name}", flush=True)
        result = sweep(hack, args.out, not args.no_render, not args.no_save)
        print(f"    {result.get('stage')}: {len(result.get('refusals', []))} refused"
              + (f"; {result['error']}" if result.get("error") else ""), flush=True)
        results.append(result)
        results_path.write_text(json.dumps(results, indent=1))
        (args.out / "summary.md").write_text(summary(results))
    against = regressions(results, baseline) if baseline is not None else None
    (args.out / "summary.md").write_text(summary(results, against))
    if against:
        print(f"{len(against)} regressions against {args.baseline}:")
        for h, w in against:
            print(f"  {h}: {w}")
        return 1
    return 0


REVISION = revision()

if __name__ == "__main__":
    sys.exit(main())
